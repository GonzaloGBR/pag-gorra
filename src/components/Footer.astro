---
import { INSTAGRAM_URL, whatsappFooterLinks } from '../lib/site';
---

<footer
  class="mt-10 flex w-full flex-col items-center justify-between gap-6 border-t border-hairline bg-canvas px-margin-mobile py-8 sm:mt-12 sm:gap-8 sm:py-10 md:mt-section-gap md:flex-row md:gap-6 md:px-margin-desktop md:py-12"
>
  <a href="/" class="shrink-0" aria-label="MLCAPS — inicio">
    <img
      src="/images/mlcaps-logo.png"
      alt="ML CAPS"
      width="100"
      height="40"
      class="h-9 w-auto object-contain"
    />
  </a>

  <div class="flex flex-col items-center gap-3 md:items-start">
    <a
      href={INSTAGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="font-label-caps inline-flex min-h-11 items-center text-ink transition-opacity hover:opacity-70"
    >
      @mlcaps.2
    </a>
    <div class="flex flex-col items-center gap-1 md:items-start">
      {
        whatsappFooterLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-label-caps inline-flex min-h-11 items-center text-secondary transition-opacity hover:text-ink hover:opacity-70"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>

  <p class="font-label-caps text-center text-secondary md:text-right">
    © 2026 MLCAPS. VIOLENT SIMPLICITY.
  </p>
</footer>
