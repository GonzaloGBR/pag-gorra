---
import { navLinks, WHATSAPP_NAV_MESSAGE, type NavActive } from '../lib/site';
import { whatsappUrl, WHATSAPP_PRIMARY } from '../lib/whatsapp';

interface Props {
  active?: NavActive;
  backHref?: string;
}

const { active = 'none', backHref } = Astro.props;

const whatsappComprar = whatsappUrl(WHATSAPP_PRIMARY, WHATSAPP_NAV_MESSAGE);
---

<nav
  class="nav-root fixed top-0 left-0 z-50 w-full border-b border-hairline/50 bg-canvas/80 backdrop-blur-sm"
  aria-label="Principal"
>
  <div
    class="nav-bar px-margin-mobile md:px-margin-desktop"
  >
    <div class="nav-side nav-side--left">
      <div
        class:list={[
          'nav-side__links',
          backHref ? 'nav-side__links--product' : 'nav-side__links--home',
        ]}
      >
        {
          navLinks.map((link) => {
            const isActive = !backHref && link.key === 'coleccion' && active === 'coleccion';
            const href = backHref && link.key === 'coleccion' ? backHref : link.href;
            const isBack = Boolean(backHref && link.key === 'coleccion');
            const isDesktopOnly = Boolean(backHref && link.key !== 'coleccion');

            return (
              <a
                href={href}
                class:list={[
                  'nav-pill',
                  isBack && 'nav-pill--back',
                  isActive && 'nav-pill--active',
                  isDesktopOnly && 'nav-pill--desktop-only',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {isBack ? (
                  <>
                    <span class="nav-pill__icon" aria-hidden="true">←</span>
                    <span class="nav-pill__label">Colección</span>
                  </>
                ) : (
                  <span class="nav-pill__label">{link.label}</span>
                )}
              </a>
            );
          })
        }
      </div>
    </div>

    <a href="/" class="nav-logo-link" aria-label="MLCAPS — inicio">
        <img
          src="/images/mlcaps-logo.png"
          alt="ML CAPS"
          width="347"
          height="381"
          class="nav-logo"
          decoding="async"
        />
    </a>

    <div class="nav-side nav-side--right">
      <a
        href={whatsappComprar}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-action-btn nav-whatsapp-desktop flex items-center justify-center rounded-full border border-ink text-ink transition-opacity hover:opacity-70"
        aria-label="Comprar por WhatsApp"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="nav-action-btn__icon"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
      </a>

      <button
        type="button"
        id="nav-menu-btn"
        class="nav-menu-btn nav-action-btn flex items-center justify-center rounded-full border border-hairline text-ink transition-opacity hover:opacity-70 md:hidden"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <span class="nav-hamburger" aria-hidden="true">
          <span class="nav-hamburger__line"></span>
          <span class="nav-hamburger__line"></span>
          <span class="nav-hamburger__line"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Backdrop móvil -->
  <div
    id="nav-mobile-backdrop"
    class="nav-mobile-backdrop md:hidden"
    aria-hidden="true"
    hidden
  ></div>

  <!-- Panel móvil -->
  <div
    id="nav-mobile-menu"
    class="nav-mobile-menu border-t border-hairline/50 bg-canvas/95 backdrop-blur-sm md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
    aria-hidden="true"
    inert
  >
    <div class="nav-mobile-menu__inner px-margin-mobile py-4">
      <ul class="flex flex-col gap-2">
        {
          navLinks.map((link) => {
            const isActive = !backHref && link.key === 'coleccion' && active === 'coleccion';
            const href = backHref && link.key === 'coleccion' ? backHref : link.href;
            const label =
              backHref && link.key === 'coleccion' ? '← Colección' : link.label;

            return (
              <li>
                <a
                  href={href}
                  data-nav-mobile-link
                  class:list={[
                    'nav-pill nav-pill--mobile',
                    isActive && 'nav-pill--active',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</nav>

<style>
  .nav-root {
    --nav-side-h: calc(var(--nav-logo-h) * 0.8);
    --nav-ease-out: cubic-bezier(0.32, 0.72, 0, 1);
    --nav-ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
    --nav-duration: 360ms;
  }

  .nav-bar {
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    height: var(--nav-bar-h);
    min-height: var(--nav-bar-h);
    max-height: var(--nav-bar-h);
    overflow: hidden;
  }

  .nav-side {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    gap: 0.5rem;
  }

  .nav-side--left {
    justify-content: flex-start;
  }

  .nav-side--right {
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .nav-side__links {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-side__links--product {
    display: flex;
  }

  @media (min-width: 768px) {
    .nav-side__links--home {
      display: flex;
    }
  }

  .nav-whatsapp-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-whatsapp-desktop {
      display: flex;
    }
  }

  .nav-action-btn {
    box-sizing: border-box;
    flex-shrink: 0;
    width: var(--nav-side-h);
    height: var(--nav-side-h);
    min-width: var(--nav-side-h);
    min-height: var(--nav-side-h);
    max-width: var(--nav-side-h);
    max-height: var(--nav-side-h);
  }

  .nav-action-btn__icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* Enlaces Colección / Locales / Contacto */
  .nav-pill {
    position: relative;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: var(--nav-side-h);
    min-height: 0;
    max-height: var(--nav-side-h);
    padding: 0 0.875rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-secondary);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    border-radius: 9999px;
    background-color: transparent;
    transition: color 0.28s var(--nav-ease-standard, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .nav-pill__label {
    display: inline-block;
    transform-origin: center center;
    transition:
      transform 0.28s var(--nav-ease-out, cubic-bezier(0.32, 0.72, 0, 1)),
      color 0.28s var(--nav-ease-standard, cubic-bezier(0.4, 0, 0.2, 1));
  }

  .nav-pill__icon {
    display: inline-block;
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-pill:not(.nav-pill--active):hover {
      color: var(--color-ink);
    }

    .nav-pill:hover .nav-pill__label {
      transform: scale(1.1);
    }

    .nav-pill--active:hover {
      color: var(--color-canvas);
    }
  }

  .nav-pill:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .nav-pill--active {
    color: var(--color-canvas);
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    box-shadow: 0 4px 12px rgb(17 17 17 / 0.12);
  }

  .nav-pill--back {
    color: var(--color-ink);
    border-color: var(--color-hairline);
    background-color: rgb(255 255 255 / 0.6);
  }

  @media (max-width: 767px) {
    .nav-pill--desktop-only {
      display: none;
    }
  }

  .nav-pill--mobile {
    width: 100%;
    justify-content: flex-start;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill,
    .nav-pill__label {
      transition-duration: 0.01ms;
    }

    .nav-pill:hover .nav-pill__label {
      transform: none;
    }
  }

  .nav-logo-link {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    transform: translate(-50%, -50%);
    transition: transform 0.28s var(--nav-ease-out, cubic-bezier(0.32, 0.72, 0, 1));
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-logo-link:hover {
      transform: translate(-50%, -50%) scale(1.04);
    }
  }

  .nav-logo {
    display: block;
    width: auto;
    height: var(--nav-logo-h);
    max-width: min(42vw, 9rem);
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgb(17 17 17 / 0.08));
  }

  @media (min-width: 768px) {
    .nav-logo {
      max-width: 10.5rem;
    }
  }



  /* Hamburguesa → X */
  .nav-hamburger {
    position: relative;
    display: flex;
    width: 1.25rem;
    height: 1rem;
    flex-direction: column;
    justify-content: space-between;
  }

  .nav-hamburger__line {
    display: block;
    height: 2px;
    width: 100%;
    border-radius: 1px;
    background-color: currentColor;
    transform-origin: center;
    transition:
      transform var(--nav-duration) var(--nav-ease-out),
      opacity calc(var(--nav-duration) * 0.75) var(--nav-ease-standard);
  }

  .nav-menu-btn.is-open .nav-hamburger__line:nth-child(1) {
    transform: translateY(0.4375rem) rotate(45deg);
  }

  .nav-menu-btn.is-open .nav-hamburger__line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .nav-menu-btn.is-open .nav-hamburger__line:nth-child(3) {
    transform: translateY(-0.4375rem) rotate(-45deg);
  }

  /* Backdrop */
  .nav-mobile-backdrop {
    position: fixed;
    inset: 0;
    top: var(--nav-bar-h);
    z-index: -1;
    background-color: rgb(17 17 17 / 0.22);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--nav-duration) var(--nav-ease-standard);
  }

  .nav-mobile-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Panel slide + fade */
  .nav-mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-0.375rem);
    pointer-events: none;
    transition:
      grid-template-rows var(--nav-duration) var(--nav-ease-out),
      opacity var(--nav-duration) var(--nav-ease-standard),
      transform var(--nav-duration) var(--nav-ease-out);
  }

  .nav-mobile-menu__inner {
    min-height: 0;
    overflow: hidden;
  }

  .nav-mobile-menu.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-mobile-menu.is-open .nav-mobile-menu__inner a {
    animation: nav-link-in var(--nav-duration) var(--nav-ease-out) backwards;
  }

  .nav-mobile-menu.is-open .nav-mobile-menu__inner li:nth-child(1) a {
    animation-delay: 40ms;
  }

  .nav-mobile-menu.is-open .nav-mobile-menu__inner li:nth-child(2) a {
    animation-delay: 70ms;
  }

  .nav-mobile-menu.is-open .nav-mobile-menu__inner li:nth-child(3) a {
    animation-delay: 100ms;
  }

  @keyframes nav-link-in {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-root {
      --nav-duration: 1ms;
    }

    .nav-mobile-menu.is-open .nav-mobile-menu__inner a {
      animation: none;
    }
  }
</style>

<script>
  const NAV_TRANSITION_MS = 360;

  function initNavMenu() {
    const btn = document.getElementById('nav-menu-btn');
    const panel = document.getElementById('nav-mobile-menu');
    const backdrop = document.getElementById('nav-mobile-backdrop');
    if (!btn || !panel || !backdrop || btn.dataset.navInit === 'true') return;
    btn.dataset.navInit = 'true';

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const transitionMs = () => (prefersReducedMotion() ? 0 : NAV_TRANSITION_MS);

    const clearCloseTimer = () => {
      if (closeTimer !== null) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
    };

    const setOpen = (open: boolean) => {
      clearCloseTimer();

      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute(
        'aria-label',
        open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación',
      );
      btn.classList.toggle('is-open', open);

      if (open) {
        backdrop.removeAttribute('hidden');
        panel.removeAttribute('inert');
        panel.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'false');

        requestAnimationFrame(() => {
          panel.classList.add('is-open');
          backdrop.classList.add('is-open');
        });

        document.body.style.overflow = 'hidden';
        return;
      }

      panel.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      const ms = transitionMs();
      closeTimer = setTimeout(() => {
        panel.setAttribute('inert', '');
        backdrop.setAttribute('hidden', '');
        closeTimer = null;
      }, ms);
    };

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    backdrop.addEventListener('click', () => setOpen(false));

    panel.querySelectorAll('[data-nav-mobile-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });

    const mq = window.matchMedia('(min-width: 768px)');
    const onMq = () => {
      if (mq.matches) setOpen(false);
    };
    mq.addEventListener('change', onMq);

    document.addEventListener(
      'astro:before-swap',
      () => {
        clearCloseTimer();
        document.body.style.overflow = '';
        mq.removeEventListener('change', onMq);
      },
      { once: true },
    );
  }

  initNavMenu();
  document.addEventListener('astro:page-load', initNavMenu);
</script>
